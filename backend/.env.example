# ════════════════════════════════════════════
# Skynet Backend Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ════════════════════════════════════════════

# ── LLM gateway (required) ──
# Skynet talks to one OpenAI-compatible endpoint for every LLM call. Point
# OPENAI_API_BASE at it and set OPENAI_API_KEY to whatever token the gateway
# expects (any non-empty string for endpoints that don't authenticate
# per-user). For local development, run the LiteLLM proxy from
# deploy/litellm/ and point this at http://localhost:4000.
OPENAI_API_BASE=https://llm.your-company.com/v1
OPENAI_API_KEY=replace-me

# ── Public-cloud providers (optional) ──
# OpenRouter is the platform's sole LLM provider: the model catalog and the
# shipped agent default (the catalog's best-value model) both require
# OPENROUTER_API_KEY.
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
# Local dev: use a separate key with a spend limit of $20 or less, never the
# production key. When APP_ENVIRONMENT is unset, startup warns when the key has no limit or a
# larger one, since local runs would spend the balance behind user top-ups.
#
# ── Agent web access ──
# Firecrawl key: gives the wizard agent web search, link reading and site
# crawling. Unset leaves the agent without web tools.
# FIRECRAWL_API_KEY=fc-your-firecrawl-key-here
#
# Run connectors (hosted MCP tools). The parent gateway holds each key and
# meters every call in the run budget. A connector with no key is not
# offered. `web_search` uses FIRECRAWL_API_KEY above.
# GOOGLE_MAPS_API_KEY=
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
#
# ── Dictation speech-to-text ──
# Whisper large-v3-turbo through OpenRouter is the sole STT provider. Use a
# dedicated OpenRouter key. Unset disables composer dictation with a typed 503.
# TRANSCRIPTION_API_KEY=sk-or-your-openrouter-key-here
# Dictation is paid by the platform, not user balances, and is open only to
# accounts with a topped-up balance or a verified BYOK key
# (a verified OpenRouter BYOK key is used instead of this one). Monthly
# dictation budget in dollars (0 disables) and a per-account hourly clip cap
# (0 disables).
# TRANSCRIPTION_MONTHLY_BUDGET_USD=10
# RATE_LIMIT_TRANSCRIPTIONS_PER_HOUR=120

# ── Database (PostgreSQL, must have pgvector) ──
REMOTE_DB_URL=postgresql://skynet:replace-me@localhost:5432/skynet
# Used by docker-compose to seed the bundled Postgres container. Pick a
# strong value for any non-local stack — compose now requires it explicitly.
POSTGRES_PASSWORD=replace-me

# ── Server ──
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ── Operational alerts (optional) ──
# Forward operational problems (unhandled 500s, a dead worker, a low provider
# balance) to a chat channel so they don't just scroll past in the logs. Set an
# incoming webhook URL to turn alerting on; leave it unset and everything stays
# in the logs only. The payload is Slack's {"text": …} shape, which Mattermost
# and Google Chat also accept.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# ALERT_MIN_LEVEL=ERROR              # min log level forwarded (>= LOG_LEVEL)
# ALERT_ENVIRONMENT=prod             # label prefixed to each alert in a shared channel
# ALERT_EMAIL=ops@example.com        # also email alerts here (needs the SMTP_* settings)
# ALERT_EMAIL_MAX_PER_HOUR=20        # per-process cap on alert emails
# ALERT_THROTTLE_SECONDS=300         # collapse identical alerts within this window (0 = off)
#
# Usage markup: platform-paid metered charges (managed LLM tokens and Vercel
# sandbox compute) bill provider cost times this multiplier. 1.15 = cost + 15%.
# BYOK runs ignore it and pay only the 5% platform fee on model cost.
# USAGE_MARKUP=1.15
#
# OpenRouter float watch: the shared prepaid balance is refilled by OpenRouter's
# native Auto Top-Up from a saved card; these settings only detect when that
# stops working. Checked after every balance top-up and every
# OPENROUTER_FLOAT_CHECK_INTERVAL_SECONDS on the API pods; a breach logs a
# WARNING, posts to ALERT_WEBHOOK_URL, and emails OPENROUTER_FLOAT_ALERT_EMAIL
# (needs SMTP_HOST). Requires OPENROUTER_API_KEY.
# A breach is a balance below the floor or below the balances users still hold,
# whichever is larger. Keep the floor under the Auto Top-Up threshold: OpenRouter
# turns Auto Top-Up off after a declined charge and has no API to report it, so
# a balance that sinks past the threshold into the floor is the only signal.
# OPENROUTER_BALANCE_FLOOR_CENTS=1000        # cents; 0 disables the watch
# OPENROUTER_FLOAT_CHECK_INTERVAL_SECONDS=900  # 0 = post-purchase check only
# OPENROUTER_FLOAT_ALERT_EMAIL=ops@example.com
# OPENROUTER_FLOAT_ALERT_COOLDOWN_SECONDS=21600  # min gap between notifications (Redis-shared)
#
# Provider card funding: providers are paid with a Stripe Issuing virtual card,
# which spends only from the Issuing balance. Below the floor the API pods
# refill it to the target, first from the Stripe payments balance (Balance
# Transfers beta) and otherwise by a bank top-up (up to 5 business days).
# Failures alert like the float watch.
# ISSUING_BALANCE_FLOOR_CENTS=5000           # 0 disables the loop
# ISSUING_BALANCE_TARGET_CENTS=15000         # must exceed the floor
# ISSUING_FUNDING_CHECK_INTERVAL_SECONDS=900

# ── CORS ──
# Comma-separated list of allowed origins (defaults to localhost:3000,3001)
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourdomain.com

# ── Worker ──
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL=2.0
WORKER_STALE_THRESHOLD=600
JOB_MAX_ATTEMPTS=3

# ── Database pool ──
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30
DB_PGBOUNCER_TRANSACTION_MODE=false
# Usually set by the Docker build; runtime falls back to `git rev-parse HEAD`.
# The pre-rename name SKYNET_CODE_VERSION is still read.
# APP_CODE_VERSION=

# ── Per-user quota ──
# Default cap for users without a live DB override. Admins can update
# individual users from the settings modal without a backend restart.
MAX_JOBS_PER_USER=100
# Hosted production guardrails. Keep the account ceiling above the MAU target
# so dormant accounts do not consume monthly capacity.
# MAX_TOTAL_USERS=20000
# MAX_MONTHLY_ACTIVE_USERS=10000
# MAX_CONCURRENT_JOBS_PER_USER=5
# Platform-wide trailing-24h spend backstop (cents). Defaults to
# 5000 ($50). Tripping it refuses new submissions with a 503 and fires an ERROR alert.
# 0 disables it.
GLOBAL_DAILY_SPEND_CEILING_CENTS=5000
# Minimum spendable balance in cents before an interactive LLM turn starts (default 5).
# INTERACTIVE_MIN_BALANCE_CENTS=5
# Free black-box wizard agent turns per account per UTC day (default 50; 0 = no cap).
# WIZARD_AGENT_DAILY_TURNS=50
# SUBMISSIONS_PAUSED=false
# REDIS_URL=redis://user:password@host:6379/0
# RATE_LIMIT_SUBMISSIONS_PER_MINUTE=30
# RATE_LIMIT_ACCOUNT_REQUESTS_PER_HOUR=20
# Shared with the frontend. Required for backend verification of admin UI calls.
BACKEND_AUTH_SECRET=change-me-in-production
# Prefer IdP groups for admins. ADMIN_USERNAMES is break-glass only.
# ADMIN_GROUPS=Skynet Admins,Platform Ops
# ADMIN_USERNAMES=bob@example.com,ops@example.com
# QUOTA_OVERRIDES={"legacy_power_user":500,"legacy_unlimited":null}

# ── Agent models ──
# Both agents (code agent and generalist agent) follow the model catalog's
# best-value default, which moves with OpenRouter's live prices and
# benchmarks, falling back to DEFAULT_AGENT_MODEL_ID in core/config.py until
# the catalog loads. Both expect OPENROUTER_API_KEY above.
#
# To run an agent on another OpenAI-compatible gateway, override BOTH its
# model id and its base URL.
# CODE_AGENT_MODEL=openai/your-internal-model
# CODE_AGENT_BASE_URL=https://llm.your-company.com/v1
# GENERALIST_AGENT_MODEL=openai/your-internal-model
# GENERALIST_AGENT_BASE_URL=https://llm.your-company.com/v1
#
# Repository runs whose optimize.toml has [rules] use two OpenRouter judges on
# the managed key, billed to the run. Empty follows the catalog: the watch
# judge runs the best-value model, the final judge the strongest model.
# RULE_WATCH_MODEL=openrouter/vendor/fast-model
# RULE_JUDGE_MODEL=openrouter/vendor/strong-model

# ── Black-box agent targets (Vercel Sandbox, optional) ──
# Black-box jobs whose target is a coding agent (and the Meta-Harness engine)
# run every scorer call in a throwaway Vercel sandbox: the harness under
# optimization is written into a fresh microVM, the agent runs the case, the
# sandbox is destroyed. All three VERCEL_* values are required to enable it;
# leaving them unset keeps text targets working and reports agent targets
# as unavailable. The harnesses reach their model through the gateway below
# (falls back to LITELLM_PROXY_URL / LITELLM_PROXY_API_KEY), which must be
# reachable from Vercel's network.
# VERCEL_TOKEN=vercel_your-access-token
# VERCEL_TEAM_ID=team_xxxxxxxx
# VERCEL_PROJECT_ID=prj_xxxxxxxx
# BLACKBOX_AGENT_GATEWAY_URL=https://proxy.example.com/v1
# BLACKBOX_AGENT_GATEWAY_API_KEY=sk-your-gateway-virtual-key
# Python scorers run in the same managed sandbox as their optimization; their
# llm() calls return through the parent-owned gateway above.
# Protected wizard runs require Ready linux/amd64 images in Vercel Container
# Registry, using immutable @sha256 references. Tags and the universal image
# do not prove the required pinned backend/optimizer/harness dependencies.
# Build backend/Dockerfile for the exact deployed source; see SANDBOX_RUNTIME.md.
# Both variables may use the same verified image digest. Replace the digest
# placeholder with all 64 hexadecimal characters returned by the registry.
# VERCEL_SANDBOX_IMAGE=vcr.vercel.com/<team>/<project>/skynet-runtime@sha256:<digest>
# DSPY_SANDBOX_IMAGE=vcr.vercel.com/<team>/<project>/skynet-runtime@sha256:<digest>
# The default ceiling is 2700 seconds; configure within your Vercel plan limit.
# Vercel accepts at most 18000 (5 hours); a larger value is refused at startup.
# VERCEL_SANDBOX_MAX_LIFETIME_SECONDS=2700
# Every production optimization uses this managed sandbox. Ordinary workers
# retain orchestration, metering, credential brokering, and persistence only.

# ── Explore search backend ──
# One knob picks the search engine and the Postgres extension it requires:
#   lexical  (default): vanilla Postgres, no extension, ILIKE substring search.
#   bm25:    needs the pg_search extension (ranked lexical; ILIKE fallback).
#   semantic: needs the pgvector extension + the embedding gateway below.
# SEARCH_BACKEND=lexical

# ── Embedding pipeline (only when SEARCH_BACKEND=semantic) ──
# Each successful job is summarised + embedded; the public /explore scatter
# is the only consumer. Point at an internal OpenAI-compatible embedding API.
# The backend sends POST {EMBEDDINGS_BASE_URL}/embeddings with {model, input}.
# If EMBEDDINGS_API_KEY is unset, OPENAI_API_KEY is reused.
# EMBEDDINGS_BASE_URL=https://llm.your-company.com/v1
# EMBEDDINGS_MODEL=jina-embeddings-v4
# Platform-wide monthly embedding token cap; past it search degrades as if
# the embedder were down (0 disables).
# EMBEDDINGS_MONTHLY_TOKEN_CAP=50000000
# Per-account monthly embedding token cap (anonymous searches share one
# bucket); past it that account's search degrades the same way (0 disables).
# EMBEDDINGS_USER_MONTHLY_TOKEN_CAP=2000000
# Share of each platform budget (dictation, embeddings) one process may spend on its
# own when Redis is unset or unreachable; 0 refuses every budgeted call then.
# PLATFORM_BUDGET_FALLBACK_FRACTION=0.1
# EMBEDDINGS_API_KEY=
# Before embedding, each finished job is summarised to prose (its title,
# description and a sample of its data) by a small LLM; that summary is what
# gets embedded. Defaults to CODE_AGENT_MODEL when unset. LiteLLM model id —
# prefix an OpenRouter slug with openrouter/ (mirrors the agent default).
# The summary call is billed to the job owner's balance; an owner with an
# empty balance gets a free title+description summary instead.
# EMBEDDINGS_SUMMARY_MODEL=openrouter/deepseek/deepseek-v4.1-flash
# Missing or stale rows are repaired continuously in bounded, advisory-locked
# passes. Increase the interval or lower the batch size if the embedding
# provider has tight rate limits.
# EMBEDDING_INDEX_SWEEP_INTERVAL=60
# EMBEDDING_INDEX_SWEEP_BATCH_SIZE=25

# ── Product notification links ──
# Public frontend origin used in job/share notification email links.
# FRONTEND_URL=https://skynet.yourcompany.com

# ── Stripe billing (managed pay-as-you-go balance) ──
# Leave STRIPE_SECRET_KEY unset to run without billing: the wallet reads as a
# free tier and every purchase route returns 503. Use test-mode keys (sk_test_…,
# whsec_…) until you go live. APP_PUBLIC_URL is where Checkout returns the buyer.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# APP_PUBLIC_URL=http://localhost:3000
# Price ids from `python scripts/provision_stripe.py` (or the Stripe dashboard):
# STRIPE_PRICE_PACK_STARTER=price_...
# STRIPE_PRICE_PACK_PLUS=price_...
# STRIPE_PRICE_PACK_PRO=price_...
# ── Mac app hosted link (local mode only, SKY-124) ──
# The hosted Skynet a local-mode backend links to. Unset means production
# (https://skynetml.com, API https://api.skynetml.com). Dev builds use staging.
APP_HOSTED_TARGET=staging

# ── BYOK key vault ──
# Fernet key (urlsafe base64, 32 bytes) that encrypts stored bring-your-own-key
# provider secrets at rest. Leave unset to disable saving provider keys (the
# vault degrades to read-only; reads of already-stored masked metadata still
# work). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BYOK_VAULT_KEY=
# "Continue with OpenRouter" (PKCE, no app registration) needs only the vault
# key above. OPENROUTER_OAUTH_REDIRECT_URI overrides the callback URL derived
# from the request (<backend origin>/billing/byok/openrouter/oauth/callback);
# set it when a proxy hides the scheme or host.
# OPENROUTER_OAUTH_REDIRECT_URI=

# ── Connectors: Hugging Face ──
# Users connect their own Hugging Face account under Settings → Connectors to
# import datasets (private and gated ones included). Tokens are encrypted with
# BYOK_VAULT_KEY, so that key must be set for connectors to save anything.
# Create an OAuth app at https://huggingface.co/settings/applications/new with
# redirect URL <backend origin>/connectors/huggingface/oauth/callback and scopes
# openid, profile, read-repos, gated-repos. Leave HF_OAUTH_CLIENT_ID unset to
# offer only the paste-a-token path. HF_OAUTH_REDIRECT_URI overrides the
# callback URL derived from the request (set it when a proxy hides the scheme).
# HF_OAUTH_CLIENT_ID=
# HF_OAUTH_CLIENT_SECRET=
# HF_OAUTH_REDIRECT_URI=

# ── Connectors: Google Sheets, GitHub, S3, GCS, Azure Blob and friends ──
# All share BYOK_VAULT_KEY for encryption at rest. Pasted credentials (access
# keys, a service-account key, a connection string or SAS URL, a token) need
# nothing here. Google Sheets and GitHub additionally offer OAuth when a
# client is registered:
#   Google: create a web OAuth client at https://console.cloud.google.com/apis/credentials
#           with redirect URI <backend origin>/connectors/google_sheets/oauth/callback
#           and enable the Drive, Sheets and Google Picker APIs. OAuth asks only
#           for drive.file, so users pick files in the Google Picker; that needs
#           GOOGLE_PICKER_API_KEY, a browser API key from the same project
#           restricted to the frontend's HTTP referrers.
#   GitHub: create an OAuth app at https://github.com/settings/developers with
#           callback URL <backend origin>/connectors/github/oauth/callback.
#   GitLab: create an application at https://gitlab.com/-/user_settings/applications
#           (confidential, scopes api read_user) with redirect URI
#           <backend origin>/connectors/gitlab/oauth/callback.
#   Bitbucket: add an OAuth consumer under the workspace settings at
#           https://bitbucket.org (permissions account read, repository write,
#           pull request write) with callback URL
#           <backend origin>/connectors/bitbucket/oauth/callback.
#   GitLab and Bitbucket tokens expire after two hours, so the worker needs
#   the client id and secret too: it refreshes the tokens during a run.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=
# GOOGLE_PICKER_API_KEY=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=
# GITLAB_OAUTH_CLIENT_ID=
# GITLAB_OAUTH_CLIENT_SECRET=
# GITLAB_OAUTH_REDIRECT_URI=
# BITBUCKET_OAUTH_CLIENT_ID=
# BITBUCKET_OAUTH_CLIENT_SECRET=
# BITBUCKET_OAUTH_REDIRECT_URI=
#   Google Drive reuses the Google client above; also register
#           <backend origin>/connectors/google_drive/oauth/callback on it.
#           GCS and BigQuery link only with a service-account key.
#   Microsoft (OneDrive, Azure Blob): register a web app at https://entra.microsoft.com
#           with redirect URIs <backend origin>/connectors/{onedrive,azure_blob}/oauth/callback,
#           delegated Files.Read / Files.Read.All / User.Read permissions and
#           Azure Storage user_impersonation. Users also need a data role
#           (e.g. Storage Blob Data Reader) on the storage account.
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_REDIRECT_URI=
#   Notion: create a public integration at https://www.notion.so/profile/integrations
#           with redirect URI <backend origin>/connectors/notion/oauth/callback.
#           Unset keeps only the internal-integration token path.
# NOTION_OAUTH_CLIENT_ID=
# NOTION_OAUTH_CLIENT_SECRET=
# NOTION_OAUTH_REDIRECT_URI=
#   Supabase: create an OAuth app under Organization settings > OAuth Apps at
#           https://supabase.com/dashboard with redirect URI
#           <backend origin>/connectors/supabase/oauth/callback and read access to
#           Projects, Organizations and Database. Unset keeps only the
#           connection-URL path.
# SUPABASE_OAUTH_CLIENT_ID=
# SUPABASE_OAUTH_CLIENT_SECRET=
# SUPABASE_OAUTH_REDIRECT_URI=
# Row cap for record-style imports (database tables, LLM traces, Notion).
# CONNECTOR_IMPORT_MAX_ROWS=20000

# ── Outbound email (email one-time sign-in codes / email 2FA) ──
# Leave SMTP_HOST unset to disable email-based 2FA (the option hides and any
# send-code call returns a typed "email delivery unavailable" error). Set it to
# an SMTP relay to turn email codes on.
#   Local dev: catch mail with Mailpit — no account, nothing leaves your machine:
#     docker run -d --name skynet-mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit
#     SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_STARTTLS=false; view at :8025.
#   Production: point at a transactional provider (Resend/SendGrid/Mailgun/SES).
#     Typical: SMTP_PORT=587, SMTP_STARTTLS=true, plus SMTP_USERNAME/SMTP_PASSWORD.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Skynet <no-reply@yourdomain.com>
# SMTP_STARTTLS=true

# ── PR preview environments ──
# APP_ENVIRONMENT names the deployment; a name ending in -pr-<n> is a preview.
# There, sign-ups still confirm their email with a code, and each new account gets
# PREVIEW_GRANT_CENTS once, so the merger can sign up and pay for a test run.
# Set it on the base environment; it does nothing outside previews.
# PREVIEW_GRANT_CENTS=0

# ── Browser web push (the Chrome notification channel) ──
# Leave unset to keep web push off (the settings grid's Chrome column then
# can't subscribe). Generate a pair once per environment, e.g. with
# `npx web-push generate-vapid-keys` (public = uncompressed P-256 point,
# private = raw scalar, both urlsafe base64); rotating it orphans every saved
# browser subscription.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@yourdomain.com

# ── Slack app (the Slack notification channel) ──
# Leave unset to keep the settings grid's Slack column off. Create the app from
# the manifest in docs/slack-app-setup.md; the bot token each user installs is
# encrypted with BYOK_VAULT_KEY, so that key must be set too.
# SLACK_REDIRECT_URL overrides the callback URL derived from the request; it
# must match a redirect URL on the app exactly:
# https://<backend-host>/notifications/slack/oauth/callback
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_REDIRECT_URL=

# ── Analytics and error reporting (optional) ──
# First-party telemetry lands in Postgres when TELEMETRY_ENABLED=true.
# TELEMETRY_ENABLED=true
# Sentry captures unhandled API/worker errors without request bodies or user PII.
# SENTRY_DSN=https://...
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.05
